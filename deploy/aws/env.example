# AWS EC2: the real file is /etc/career-platform/env (root:career-platform, mode 0640).
# Never commit real values. systemd reads it as-is; never `source` it in a shell,
# because ADMIN_PASSWORD contains `$` characters.
ENVIRONMENT=production
SNAPSHOT_DIR=/var/lib/career-platform/snapshots
# Built from the RDS endpoint and the generated master password (plan Task 4/5).
# TLS to RDS is verified against AWS's CA bundle.
DATABASE_URL=postgresql://career_platform:<password>@<rds-endpoint>:5432/career_platform?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
# Copied from the Railway service's variables without printing them.
SECRET_KEY=
# The pbkdf2_sha256$... hash from Railway's variables (see README "Production settings").
ADMIN_PASSWORD=
