[Unit]
Description=Career Platform FastAPI service
After=network.target

[Service]
Type=simple
User=career-platform
Group=career-platform
WorkingDirectory=/srv/career-platform
EnvironmentFile=/etc/career-platform/.env
ExecStart=/srv/career-platform/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
